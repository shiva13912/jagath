# ---- Server --------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Browser origin(s) of the React app, comma separated. In production the API serves the app itself.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx) so rate limits see real IPs.
TRUST_PROXY=0

# ---- Database ------------------------------------------------------------
# Local:     postgres://durgamatha:durgamatha@localhost:5432/durgamatha
# Supabase:  postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# ---- Auth ----------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# First admin account, used by `npm run seed:admin` (production bootstrap).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- File storage --------------------------------------------------------
# local = files on the server disk (development). s3 = any S3-compatible service.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# S3-compatible storage (Supabase Storage recommended; Cloudflare R2 or AWS S3 also work).
# Supabase: Project Settings > Storage > S3 Connection. Create a PRIVATE bucket.
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<your project region, e.g. ap-south-1>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Upload limits in megabytes.
MAX_PHOTO_MB=15
MAX_VIDEO_MB=500
MAX_PROOF_MB=10
